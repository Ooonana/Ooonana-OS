# i3 config file (v4)
set $mod Mod4
font pango:Sans 10

floating_modifier $mod
tiling_drag modifier titlebar
focus_follows_mouse no
mouse_warping none
workspace_layout default
hide_edge_borders none
default_border normal 1
default_floating_border normal 1
gaps top 58
gaps bottom 84
gaps left 12
gaps right 12
for_window [class="Yad"] floating enable
for_window [class="^(Pavucontrol|Blueman-manager|Arandr|Nm-connection-editor)$"] floating enable, border normal 2, move position center
for_window [class="^(Nemo|Geany|Alacritty|XTerm)$"] floating enable, move position center
# Browser's first-run default can exceed output height and hide its titlebar.
# Set initial bounds only; later user resize/fullscreen remains unrestricted.
for_window [class="^(Chromium|chromium|Chromium-browser|chromium-browser|Google-chrome)$"] floating enable, resize set 80 ppt 70 ppt, move position center
for_window [window_type="dialog"] floating enable
# GTK file pickers can request more height than the output and hide both actions
# and titlebar. Bound initial file-picker size only, not ordinary message dialogs.
for_window [window_role="^GtkFileChooserDialog$"] floating enable, resize set 80 ppt 70 ppt, move position center
for_window [window_role="pop-up"] floating enable
# Native client-side headers override generic dialog decorations.
for_window [class="^OoonanaApp$"] floating enable, border none, move position center
# Spotlight's GTK request already fits the monitor; fixed pixels clip small outputs.
for_window [class="^OoonanaSpotlight$"] floating enable, border none, move position center
for_window [class="^OonanaGame$"] fullscreen enable

exec_always --no-startup-id ooonana-theme-env apply
exec --no-startup-id xsetroot -name "Ooonana OS" -cursor_name left_ptr
exec --no-startup-id sh -c 'if command -v picom >/dev/null 2>&1; then if [ "${OOONANA_WSL_SOCKET_READY:-0}" = 1 ]; then picom --backend xrender --config /etc/ooonana/picom.conf; else picom --backend glx --config /etc/ooonana/picom.conf || exec picom --backend xrender --config /etc/ooonana/picom.conf; fi; fi &'
exec --no-startup-id sh -c 'command -v dunst >/dev/null 2>&1 && dunst -config /etc/ooonana/dunstrc &'
exec --no-startup-id sh -c 'command -v xsettingsd >/dev/null 2>&1 && xsettingsd -c "${XDG_CONFIG_HOME:-$HOME/.config}/ooonana/xsettingsd.conf" &'
exec_always --no-startup-id ooonana-panel-start
exec_always --no-startup-id ooonana-window-controls
exec --no-startup-id ooonana-storage-watch
exec --no-startup-id sh -c 'command -v nm-applet >/dev/null 2>&1 && [ -S /run/dbus/system_bus_socket ] && nm-applet --indicator &'
exec --no-startup-id sh -c 'if command -v blueman-applet >/dev/null 2>&1 && [ -S /run/dbus/system_bus_socket ] && ls /sys/class/bluetooth/hci* >/dev/null 2>&1; then blueman-applet & fi'
exec --no-startup-id sh -c '[ "${OOONANA_NO_AUDIO:-0}" = 1 ] || { command -v ooonana-audio-start >/dev/null 2>&1 && ooonana-audio-start >/dev/null 2>&1; } || true'

bindsym $mod+Return exec ooonana-theme-env xterm
bindsym $mod+d exec ooonana-apps
bindsym $mod+Control+d exec ooonana-window-list --dock-menu
bindsym $mod+Control+Tab exec ooonana-window-list --task-view
bindsym $mod+Shift+d exec sh -c 'command -v rofi >/dev/null 2>&1 && rofi -show drun -theme /etc/ooonana/rofi.rasi || dmenu_run'
bindsym $mod+Shift+f exec ooonana-files
bindsym $mod+Shift+w exec ooonana-browser
bindsym $mod+n exec ooonana-wifi
bindsym $mod+b exec ooonana-bluetooth
bindsym $mod+Shift+n exec ooonana-rofi-wifi
bindsym $mod+Shift+b exec ooonana-rofi-bluetooth
bindsym $mod+Shift+s exec ooonana-settings-launch
bindsym $mod+Shift+a exec ooonana-ai-launch
bindsym $mod+Shift+c exec ooonana-notifications
bindsym $mod+Shift+o exec ooonana-packages-app
bindsym $mod+Shift+i exec ooonana-gui-installer
bindsym $mod+Shift+p exec ooonana-wallpaper
bindsym $mod+Shift+t exec ooonana-theme-env toggle
bindsym Print exec ooonana-screenshot
bindsym $mod+Shift+g exec ooonana-editor
bindsym $mod+Shift+m exec ooonana-music
bindsym $mod+Shift+x exec ooonana-processes
bindsym Control+Shift+Escape exec ooonana-processes
bindsym $mod+Shift+u exec ooonana-ranger
bindsym XF86TouchpadToggle exec ooonana-touchpad toggle
bindsym XF86TouchpadOn exec ooonana-touchpad on
bindsym XF86TouchpadOff exec ooonana-touchpad off
bindsym $mod+Shift+r restart
bindsym $mod+Shift+q kill
bindsym Mod1+F4 kill
bindsym Mod1+F10 fullscreen toggle
bindsym --release button3 exec ooonana-window-list --focused-actions
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit Ooonana i3?' -b 'Exit' 'i3-msg exit'"
bindsym $mod+Tab focus next
bindsym $mod+Shift+Tab focus prev

# Numbered workspaces remain keyboard-accessible even when panel is hidden.
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10
bindsym $mod+Control+Left workspace prev
bindsym $mod+Control+Right workspace next

bindsym $mod+minus scratchpad show
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+m move scratchpad
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
# floating_modifier supplies Super+left drag and Super+right resize. Bare
# move/resize mouse commands are invalid and override those native handlers.

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

mode "resize" {
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow width 10 px or 10 ppt
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Blend frame edges into titlebar; rectangular accent outlines are clipped by
# rounded corners. Keep focus/urgency accents in text and tiling indicators.
client.focused #1b1f26 #1b1f26 #ffb21a #ffb21a #1b1f26
client.unfocused #101317 #101317 #b4bdc8 #414957 #101317
client.focused_inactive #171b21 #171b21 #b4bdc8 #414957 #171b21
client.urgent #3b2324 #3b2324 #ff675c #ff675c #3b2324
