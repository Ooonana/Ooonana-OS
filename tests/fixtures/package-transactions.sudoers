# Disposable mount-namespace fixture only. Never install on user systems.
Defaults timestamp_timeout=0
Defaults passwd_tries=1
Defaults lecture=never
Defaults env_keep += "OOONANA_ROOT OOONANA_REPO_DIR OOONANA_SOURCES_DIR OOONANA_CACHE_DIR OOONANA_STATE_DIR OOONANA_REPO_VERIFY_KEY OOONANA_REQUIRE_SIGNED_REPOS OOONANA_KEEP_UPDATE_BACKUPS"
root ALL=(ALL:ALL) ALL
ooonana ALL=(root) PASSWD: /usr/bin/ooonana update, /usr/bin/ooonana get qa-ui-fixture, /usr/bin/ooonana get qa-ui-fixture --dry-run, /usr/bin/ooonana upgrade qa-ui-fixture, /usr/bin/ooonana upgrade qa-ui-fixture --dry-run, /usr/bin/ooonana remove qa-ui-fixture, /usr/bin/ooonana remove qa-ui-fixture --dry-run, /usr/bin/ooonana recover
