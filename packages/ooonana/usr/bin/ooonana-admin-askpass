#!/usr/bin/python3
"""Sudo askpass: secret goes only to sudo-owned pipe, never to logs or state."""
import sys
import os
sys.path.insert(0, "/usr/lib/ooonana/ui")
from common import Gtk, apply_theme, header, label

apply_theme()
dialog = Gtk.Dialog(title="Authorize administration", modal=True)
header(dialog, "Authorize", "Password required for system changes", "security-high-symbolic")
dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Authorize", Gtk.ResponseType.OK)
area = dialog.get_content_area()
area.set_border_width(20)
area.set_spacing(12)
area.pack_start(label("Enter your account password."), False, False, 0)
entry = Gtk.Entry()
entry.get_accessible().set_name("Account password")
entry.set_visibility(False)
entry.set_input_purpose(Gtk.InputPurpose.PASSWORD)
entry.set_activates_default(True)
area.pack_start(entry, False, False, 0)
dialog.set_default_response(Gtk.ResponseType.OK)

# Parent hint affects presentation only. Sudo/PAM still authenticate the user.
parent_xid = os.environ.get("OOONANA_PARENT_XID", "")
if 1 <= len(parent_xid) <= 10 and parent_xid.isascii() and parent_xid.isdecimal() and 0 < int(parent_xid) <= 0xffffffff:
    from gi.repository import GdkX11
    dialog.realize()
    display = dialog.get_display()
    display.error_trap_push()
    try:
        parent = GdkX11.X11Window.foreign_new_for_display(display, int(parent_xid))
        if parent is not None:
            dialog.get_window().set_transient_for(parent)
    finally:
        display.error_trap_pop()
dialog.show_all()
entry.grab_focus()
accepted = dialog.run() == Gtk.ResponseType.OK
secret = entry.get_text() if accepted else ""
entry.set_text("")
dialog.destroy()
if not accepted or not secret:
    sys.exit(1)
sys.stdout.write(secret + "\n")
