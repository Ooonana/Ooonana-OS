#!/bin/sh
set -eu

config_dir="${HOME:-/root}/.config/ooonana"
wallpaper=""
mode=""
apply_saved=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --mode)
      mode="${2:-}"
      shift 2
      ;;
    --apply-saved)
      apply_saved=1
      shift
      ;;
    -h|--help)
      echo "usage: ooonana-wallpaper [--mode fit|fill|center|stretch|tile] [IMAGE]"
      exit 0
      ;;
    -*)
      echo "ooonana-wallpaper: unknown option: $1" >&2
      exit 2
      ;;
    *)
      wallpaper="$1"
      shift
      ;;
  esac
done

if [ -z "$wallpaper" ]; then
  wallpaper="/usr/share/ooonana/wallpapers/ooonana-notes.jpg"
  if [ -f "$config_dir/wallpaper" ]; then
    IFS= read -r saved <"$config_dir/wallpaper" || saved=""
    [ -n "$saved" ] && wallpaper="$saved"
  fi
fi

if [ -z "$mode" ]; then
  mode="fit"
  if [ -f "$config_dir/wallpaper-mode" ]; then
    IFS= read -r saved_mode <"$config_dir/wallpaper-mode" || saved_mode="fit"
    [ -n "$saved_mode" ] && mode="$saved_mode"
  fi
fi

case "$mode" in
  fit|fill|center|stretch|tile) ;;
  *)
    echo "ooonana-wallpaper: invalid mode: $mode" >&2
    exit 2
    ;;
esac

if [ ! -f "$wallpaper" ]; then
  printf 'missing wallpaper: %s\n' "$wallpaper" >&2
  if [ "$apply_saved" -eq 1 ] && [ -f /usr/share/ooonana/wallpapers/ooonana-notes.jpg ]; then
    # Stale saved paths must not leave login blank or destroy user's preference.
    wallpaper=/usr/share/ooonana/wallpapers/ooonana-notes.jpg
  else
    exit 1
  fi
fi

apply_wallpaper() {
  if [ "$mode" = fit ] && command -v ooonana-wallpaper-fit >/dev/null 2>&1 && command -v feh >/dev/null 2>&1; then
    ooonana-wallpaper-fit "$wallpaper"
  elif command -v hsetroot >/dev/null 2>&1; then
    hsetroot "-$mode" "$wallpaper"
  elif command -v feh >/dev/null 2>&1; then
    case "$mode" in
      fit) feh --bg-max "$wallpaper" ;;
      fill) feh --bg-fill "$wallpaper" ;;
      center) feh --bg-center "$wallpaper" ;;
      stretch) feh --bg-scale "$wallpaper" ;;
      tile) feh --bg-tile "$wallpaper" ;;
    esac
  else
    printf 'no wallpaper setter installed\n' >&2
    return 1
  fi
}

# Save only after successful rendering. Failed image/setter leaves prior choice.
apply_wallpaper
if [ "$apply_saved" -eq 0 ]; then
  mkdir -p "$config_dir"
  path_tmp=$(mktemp "$config_dir/wallpaper.XXXXXX")
  mode_tmp=""
  trap 'rm -f "$path_tmp" "$mode_tmp"' EXIT HUP INT TERM
  mode_tmp=$(mktemp "$config_dir/wallpaper-mode.XXXXXX")
  printf '%s\n' "$wallpaper" >"$path_tmp"
  printf '%s\n' "$mode" >"$mode_tmp"
  mv -f "$path_tmp" "$config_dir/wallpaper"
  mv -f "$mode_tmp" "$config_dir/wallpaper-mode"
fi

exit 0
