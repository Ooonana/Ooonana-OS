#!/bin/sh
set -eu
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

usage() {
  cat <<'USAGE'
bunana              exit current command
bunana --shutdown   power off
bunana --restart    reboot

For real shell-exit behavior, use Ooonana login shell or run:
  . bunana
USAGE
}

case "${1:-}" in
  --shutdown)
    if [ "$(id -u 2>/dev/null || echo 1)" != "0" ]; then
      if command -v ooonana-run-admin >/dev/null 2>&1; then
        exec ooonana-run-admin "$0" --shutdown
      elif command -v doas >/dev/null 2>&1; then
        exec doas "$0" --shutdown
      elif command -v sudo >/dev/null 2>&1; then
        exec sudo "$0" --shutdown
      fi
      echo "bunana: administrator helper missing" >&2
      exit 126
    fi
    sync 2>/dev/null || true
    /sbin/poweroff -f && exit 0
    /bin/busybox poweroff -f && exit 0
    /sbin/halt -f && exit 0
    echo "bunana: shutdown failed" >&2
    exit 1
    ;;
  --restart|--reboot)
    if [ "$(id -u 2>/dev/null || echo 1)" != "0" ]; then
      if command -v ooonana-run-admin >/dev/null 2>&1; then
        exec ooonana-run-admin "$0" --restart
      elif command -v doas >/dev/null 2>&1; then
        exec doas "$0" --restart
      elif command -v sudo >/dev/null 2>&1; then
        exec sudo "$0" --restart
      fi
      echo "bunana: administrator helper missing" >&2
      exit 126
    fi
    sync 2>/dev/null || true
    /sbin/reboot -f && exit 0
    /bin/busybox reboot -f && exit 0
    echo "bunana: restart failed" >&2
    exit 1
    ;;
  --help|-h)
    usage
    ;;
  *)
    exit 0
    ;;
esac
