#!/bin/sh
set -eu

if [ "${1:-}" = --watch ]; then
  while :; do
    "$0" --once
    if command -v mpc >/dev/null 2>&1; then
      while mpc idle player mixer playlist options >/dev/null 2>&1; do "$0" --once; done
    fi
    sleep 10
  done
fi

if ! command -v mpc >/dev/null 2>&1; then
  printf '%%{T2}\357\200\201%%{T-} Music\n'
  exit 0
fi

status="$(mpc status 2>/dev/null || true)"
if [ -z "$status" ]; then
  printf '%%{T2}\357\200\201%%{T-} Music\n'
  exit 0
fi

title="$(mpc --format '%title%' current 2>/dev/null | sed -n '1p')"
[ -n "$title" ] || title="$(mpc --format '%file%' current 2>/dev/null | sed -n '1p')"
max_chars="${OOONANA_MEDIA_MAX_CHARS:-18}"
case "$max_chars" in ''|*[!0-9]*) max_chars=18 ;; esac
[ "$max_chars" -ge 4 ] && [ "$max_chars" -le 40 ] || max_chars=18
title="$(printf '%s' "$title" | python3 -c 'import sys; text = sys.stdin.read(); print("".join(ch for ch in text if ch.isprintable() and ch != "%")[:int(sys.argv[1])], end="")' "$max_chars")"

if printf '%s\n' "$status" | grep -q '\[playing\]'; then
  icon='\357\201\213'
elif printf '%s\n' "$status" | grep -q '\[paused\]'; then
  icon='\357\201\214'
else
  icon='\357\200\201'
fi

if [ -n "$title" ]; then
  printf '%%{T2}%b%%{T-} %s\n' "$icon" "$title"
else
  printf '%%{T2}%b%%{T-} Music\n' "$icon"
fi
