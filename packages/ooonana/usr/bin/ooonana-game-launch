#!/bin/sh
set -eu

if command -v xterm >/dev/null 2>&1; then
  exec xterm -class OonanaGame -title "Ooonana Breakout" \
    -bg '#050505' -fg '#ffb21a' -fa monospace -fs 11 -e oonana
fi

if command -v alacritty >/dev/null 2>&1; then
  exec alacritty --class OonanaGame,OonanaGame --title "Ooonana Breakout" -e oonana
fi

if [ -t 0 ] && [ -t 1 ]; then exec oonana; fi
command -v notify-send >/dev/null 2>&1 && notify-send 'Ooonana Breakout' 'Terminal unavailable. Install xterm or alacritty.' || true
echo 'Ooonana Breakout: terminal unavailable; install xterm or alacritty' >&2
exit 127
