#!/usr/bin/env python3
import json
import shutil
import subprocess
import sys


PINS = (
    ("apps", "", ("ooonana-apps",)),
    ("terminal", "", ("ooonana-theme-env", "xterm")),
    ("browser", "", ("ooonana-browser",)),
    ("files", "", ("ooonana-files",)),
    ("editor", "", ("ooonana-editor",)),
    ("music", "", ("ooonana-music",)),
    ("openvino", "", ("ooonana-openvino-launch",)),
    ("tasks", "", ("ooonana-processes",)),
)


def available_pins():
    return [pin for pin in PINS if pin[0] != "openvino" or shutil.which(pin[2][0])]


def tree():
    try:
        output = subprocess.check_output(
            ["i3-msg", "-t", "get_tree"], text=True, stderr=subprocess.DEVNULL, timeout=3
        )
        return json.loads(output)
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
        return {}


def leaves(node, in_scratchpad=False):
    if node.get("type") == "dockarea":
        return []
    found = []
    # Scratchpad state survives showing a window; its workspace determines visibility.
    hidden = in_scratchpad or node.get("name") == "__i3_scratch"
    properties = node.get("window_properties") or {}
    panel = str(properties.get("class", "")).lower() == "polybar"
    if node.get("window") is not None and node.get("name") and not panel:
        found.append((node, hidden))
    for key in ("nodes", "floating_nodes"):
        for child in node.get(key, []):
            found.extend(leaves(child, hidden))
    return found


def windows():
    items = []
    for node, hidden in leaves(tree()):
        con_id = node.get("id")
        if not isinstance(con_id, int):
            continue
        name = " ".join("".join(ch for ch in str(node.get("name", "")) if ch.isprintable() and ch != "%").split()) or "window"
        wm_class = str((node.get("window_properties") or {}).get("class", "")).casefold()
        items.append((con_id, name, bool(node.get("focused")), hidden, wm_class))
    return items


def compact(items):
    if not items:
        return "desktop"
    focused = next((item for item in items if item[2]), items[0])
    name = focused[1]
    title = name[:22] + ("..." if len(name) > 22 else "")
    hidden_count = sum(1 for item in items if item[3])
    suffix = f" +{len(items) - 1}" if len(items) > 1 else ""
    hidden = f" ({hidden_count} hidden)" if hidden_count else ""
    return f"* {title}{suffix}{hidden}"


def bar(items):
    """Clickable, bounded window chips for Polybar; titles cannot inject tags."""
    if not items:
        return "desktop"
    ordered = sorted(items, key=lambda item: (not item[2], item[3]))
    chips = []
    for item in ordered[:3]:
        con_id, name, focused, hidden = item[:4]
        if not isinstance(con_id, int) or con_id <= 0:
            continue
        title = name[:12] + ("…" if len(name) > 12 else "")
        prefix = "●" if focused else "○" if hidden else "·"
        color = "#ffb21a" if focused else "#b4bdc8"
        background = "#303640" if focused else "#272d36"
        chips.append(
            f"%{{A1:ooonana-window-list --focus {con_id}:}}"
            f"%{{A3:ooonana-window-list --actions {con_id}:}}"
            f"%{{F{color}}}%{{B{background}}} {prefix} {title} %{{B-}}%{{F-}}%{{A}}%{{A}}"
        )
    if len(ordered) > 3:
        chips.append(f"%{{A1:ooonana-window-list --menu:}} +{len(ordered) - 3} %{{A}}")
    return " ".join(chips) or "desktop"


def pin_for(item):
    name = item[1].casefold()
    wm_class = item[4] if len(item) > 4 else ""
    if wm_class == "ooonanaspotlight" or "spotlight" in name:
        return "apps"
    if "task manager" in name or "processes" in name:
        return "tasks"
    if name == "music" or wm_class in ("ncmpcpp", "mpd"):
        return "music"
    if "openvino chat" in name or "ooonana offline ai" in name:
        return "openvino"
    if wm_class in ("xterm", "alacritty") or name in ("xterm", "terminal"):
        return "terminal"
    if "chromium" in wm_class or "chrome" in wm_class or "firefox" in wm_class:
        return "browser"
    if wm_class in ("nemo", "thunar", "pcmanfm"):
        return "files"
    if wm_class in ("geany", "mousepad", "code"):
        return "editor"
    return None


def dock(items):
    """Opaque icon dock with per-app running dots and bounded extra windows."""
    chips = []
    pins = available_pins()
    for key, icon, _command in pins:
        matches = [item for item in items if pin_for(item) == key]
        active = any(item[2] for item in matches)
        background = "#303640" if active else "#272d36" if matches else "#1b1f26"
        foreground = "#ffb21a" if active else "#f5f5f7" if matches else "#b4bdc8"
        dot = "•" if matches else " "
        chips.append(
            f"%{{A1:ooonana-window-list --dock-open {key}:}}"
            f"%{{A3:ooonana-window-list --dock-actions {key}:}}"
            f"%{{B{background}}}%{{F{foreground}}}%{{T2}} {icon} %{{T-}}{dot} "
            f"%{{B-}}%{{F-}}%{{A}}%{{A}}"
        )
    pinned_keys = {pin[0] for pin in pins}
    other = sorted((item for item in items if pin_for(item) not in pinned_keys), key=lambda item: (not item[2], item[3]))
    if other:
        chips.append("%{F#596574}│%{F-}")
    for item in other[:1]:
        con_id, name, focused, hidden = item[:4]
        if not isinstance(con_id, int) or con_id <= 0:
            continue
        title = name[:8] + ("…" if len(name) > 8 else "")
        marker = "●" if focused else "○" if hidden else "·"
        chips.append(
            f"%{{A1:ooonana-window-list --focus {con_id}:}}"
            f"%{{A3:ooonana-window-list --actions {con_id}:}}"
            f"%{{B#272d36}}%{{F#ffb21a}} {marker} %{{F#f5f5f7}}{title} "
            f"%{{F-}}%{{B-}}%{{A}}%{{A}}"
        )
    if len(other) > 1:
        chips.append(f"%{{A1:ooonana-window-list --menu:}} +{len(other) - 1} %{{A}}")
    return " ".join(chips)


def dock_open(items, key):
    command = next((command for pin, _icon, command in PINS if pin == key), None)
    if command is None:
        return
    matches = [item for item in items if pin_for(item) == key]
    if matches:
        item = matches[0] if len(matches) == 1 else choose(matches, "Open app session")
        if item is not None:
            focus(item)
        return
    try:
        subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        return


def dock_actions(items, key):
    if not any(pin == key for pin, _icon, _command in PINS):
        return
    matches = [item for item in items if pin_for(item) == key]
    if not matches:
        if choose([(0, f"Open {key.title()}", False, False, "")], "Dock") is not None:
            dock_open(items, key)
        return
    item = matches[0] if len(matches) == 1 else choose(matches, "App sessions")
    if item is not None:
        actions_menu(items, item[0])


def focus(item):
    con_id, _name, _active, hidden = item[:4]
    commands = []
    if hidden:
        commands.append(f"[con_id={con_id}] scratchpad show")
    commands.append(f"[con_id={con_id}] focus")
    subprocess.run(["i3-msg", "; ".join(commands)], check=False)


def choose(items, prompt):
    if not items:
        return None
    choices = [
        f"{'* ' if item[2] else '  '}{item[1]}{' [hidden]' if item[3] else ''}"
        for item in items
    ]
    try:
        result = subprocess.run(
            ["rofi", "-dmenu", "-i", "-p", prompt, "-format", "i"],
            input="\n".join(choices) + "\n",
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=30,
            check=False,
        )
        selected = int(result.stdout.strip())
    except (OSError, ValueError, subprocess.SubprocessError):
        return None
    return items[selected] if 0 <= selected < len(items) else None


def menu(items, close=False):
    item = choose(items, "Close window" if close else "Open window")
    if item is None:
        return
    if close:
        subprocess.run(["i3-msg", f"[con_id={item[0]}] kill"], check=False)
    else:
        focus(item)


def actions_menu(items, con_id=None):
    item = next((entry for entry in items if entry[0] == con_id), None) if con_id else choose(items, "Window actions")
    if item is None:
        return
    choices = ("Open / focus", "Minimize / hide", "Fullscreen toggle", "Close window")
    try:
        result = subprocess.run(
            ["rofi", "-dmenu", "-i", "-p", item[1][:20], "-format", "i"],
            input="\n".join(choices) + "\n", text=True,
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=30, check=False,
        )
        selected = int(result.stdout.strip())
    except (OSError, ValueError, subprocess.SubprocessError):
        return
    if selected == 0:
        focus(item)
    elif selected == 1:
        subprocess.run(["i3-msg", f"[con_id={item[0]}] move scratchpad"], check=False)
    elif selected == 2:
        if item[3]:
            focus(item)
        subprocess.run(["i3-msg", f"[con_id={item[0]}] fullscreen toggle"], check=False)
    elif selected == 3:
        subprocess.run(["i3-msg", f"[con_id={item[0]}] kill"], check=False)


def main():
    items = windows()
    if len(sys.argv) > 1 and sys.argv[1] == "--dock":
        print(dock(items))
        return
    if len(sys.argv) > 2 and sys.argv[1] == "--dock-open":
        dock_open(items, sys.argv[2])
        return
    if len(sys.argv) > 2 and sys.argv[1] == "--dock-actions":
        dock_actions(items, sys.argv[2])
        return
    if len(sys.argv) > 1 and sys.argv[1] == "--menu":
        menu(items)
        return
    if len(sys.argv) > 1 and sys.argv[1] in ("--close-menu", "--kill-menu"):
        menu(items, close=True)
        return
    if len(sys.argv) > 1 and sys.argv[1] == "--actions" and len(sys.argv) == 2:
        actions_menu(items)
        return
    if len(sys.argv) > 1 and sys.argv[1] in ("--focus", "--actions"):
        try:
            con_id = int(sys.argv[2])
        except (IndexError, ValueError):
            return
        if con_id <= 0:
            return
        item = next((entry for entry in items if entry[0] == con_id), None)
        if item is None:
            return
        if sys.argv[1] == "--focus":
            focus(item)
        else:
            actions_menu(items, con_id)
        return
    if len(sys.argv) > 1 and sys.argv[1] == "--plain":
        print(compact(items))
        return
    print(bar(items))


if __name__ == "__main__":
    main()
