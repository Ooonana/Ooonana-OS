#!/usr/bin/env python3
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import time


PINS = (
    ("apps", "", ("ooonana-apps",)),
    ("terminal", "", ("ooonana-theme-env", "xterm")),
    ("browser", "", ("ooonana-browser",)),
    ("files", "", ("ooonana-files",)),
    ("editor", "", ("ooonana-editor",)),
    ("music", "", ("ooonana-music",)),
    ("openvino", "", ("ooonana-openvino-launch",)),
    ("tasks", "", ("ooonana-processes",)),
)

PIN_COLORS = {
    "apps": "#c4a9ff", "terminal": "#c0c8d4", "browser": "#8cbcff",
    "files": "#ffd079", "editor": "#82d2b2", "music": "#ff9ab2",
    "openvino": "#c6b4ff", "tasks": "#93d5e5",
}


def available_pins():
    return [pin for pin in PINS if pin[0] != "openvino" or shutil.which(pin[2][0])]


def dock_geometry():
    width = 1280
    try:
        outputs = json.loads(subprocess.check_output(
            ["i3-msg", "-t", "get_outputs"], text=True, stderr=subprocess.DEVNULL, timeout=3
        ))
        active = [output for output in outputs if output.get("active")]
        chosen = next((output for output in active if output.get("primary")), active[0])
        width = int(chosen["rect"]["width"])
    except (OSError, subprocess.SubprocessError, ValueError, KeyError, IndexError, TypeError):
        pass
    dock_width = min(max(1, width - 24), len(available_pins()) * 58 + 168)
    print(f"OOONANA_DOCK_WIDTH={dock_width}\nOOONANA_DOCK_OFFSET={max(0, (width - dock_width) // 2)}")


def panel_layout(width):
    if width < 760:
        return ("workspaces media", "memory battery notifications controls power", 0, 10)
    if width < 1100:
        return ("brand workspaces media", "memory audio battery wifi notifications controls date power", 0, 14)
    return ("brand workspaces win-close win-min win-full media",
            "memory audio battery wifi notifications controls date power", 1, 18)


def panel_geometry():
    width = 1280
    try:
        outputs = json.loads(subprocess.check_output(["i3-msg", "-t", "get_outputs"], text=True, timeout=3))
        active = [output for output in outputs if output.get("active")]
        selected = next((output for output in active if output.get("primary")), active[0])
        width = int(selected["rect"]["width"])
    except (OSError, ValueError, KeyError, IndexError, TypeError, subprocess.SubprocessError):
        pass
    left, right, gap, media = panel_layout(width)
    print(f"OOONANA_PANEL_LEFT='{left}'\nOOONANA_PANEL_RIGHT='{right}'\nOOONANA_PANEL_GAP={gap}\nOOONANA_MEDIA_MAX_CHARS={media}")


def tree():
    try:
        output = subprocess.check_output(
            ["i3-msg", "-t", "get_tree"], text=True, stderr=subprocess.DEVNULL, timeout=3
        )
        return json.loads(output)
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
        return {}


def leaves(node, in_scratchpad=False):
    if node.get("type") == "dockarea":
        return []
    found = []
    # Scratchpad state survives showing a window; its workspace determines visibility.
    hidden = in_scratchpad or node.get("name") == "__i3_scratch"
    properties = node.get("window_properties") or {}
    panel = str(properties.get("class", "")).lower() == "polybar"
    if node.get("window") is not None and node.get("name") and not panel:
        found.append((node, hidden))
    for key in ("nodes", "floating_nodes"):
        for child in node.get(key, []):
            found.extend(leaves(child, hidden))
    return found


def windows(snapshot=None):
    items = []
    for node, hidden in leaves(tree() if snapshot is None else snapshot):
        con_id = node.get("id")
        if not isinstance(con_id, int):
            continue
        name = " ".join("".join(ch for ch in str(node.get("name", "")) if ch.isprintable() and ch != "%").split()) or "window"
        wm_class = str((node.get("window_properties") or {}).get("class", "")).casefold()
        items.append((con_id, name, bool(node.get("focused")), hidden, wm_class))
    return items


def compact(items):
    if not items:
        return "desktop"
    focused = next((item for item in items if item[2]), items[0])
    name = focused[1]
    title = name[:22] + ("..." if len(name) > 22 else "")
    hidden_count = sum(1 for item in items if item[3])
    suffix = f" +{len(items) - 1}" if len(items) > 1 else ""
    hidden = f" ({hidden_count} hidden)" if hidden_count else ""
    return f"* {title}{suffix}{hidden}"


def bar(items):
    """Clickable, bounded window chips for Polybar; titles cannot inject tags."""
    if not items:
        return "desktop"
    ordered = sorted(items, key=lambda item: (not item[2], item[3]))
    chips = []
    for item in ordered[:3]:
        con_id, name, focused, hidden = item[:4]
        if not isinstance(con_id, int) or con_id <= 0:
            continue
        title = name[:12] + ("…" if len(name) > 12 else "")
        prefix = "●" if focused else "○" if hidden else "·"
        color = "#ffb21a" if focused else "#b4bdc8"
        background = "#303640" if focused else "#272d36"
        chips.append(
            f"%{{A1:ooonana-window-list --focus {con_id}:}}"
            f"%{{A3:ooonana-window-list --actions {con_id}:}}"
            f"%{{F{color}}}%{{B{background}}} {prefix} {title} %{{B-}}%{{F-}}%{{A}}%{{A}}"
        )
    if len(ordered) > 3:
        chips.append(f"%{{A1:ooonana-window-list --menu:}} +{len(ordered) - 3} %{{A}}")
    return " ".join(chips) or "desktop"


def pin_for(item):
    name = item[1].casefold()
    wm_class = item[4] if len(item) > 4 else ""
    if wm_class == "ooonanaspotlight" or "spotlight" in name:
        return "apps"
    if "task manager" in name or "processes" in name:
        return "tasks"
    if name == "music" or wm_class in ("ncmpcpp", "mpd"):
        return "music"
    if "openvino chat" in name or "ooonana offline ai" in name:
        return "openvino"
    if wm_class in ("xterm", "alacritty") or name in ("xterm", "terminal"):
        return "terminal"
    if "chromium" in wm_class or "chrome" in wm_class or "firefox" in wm_class:
        return "browser"
    if wm_class in ("nemo", "thunar", "pcmanfm"):
        return "files"
    if wm_class in ("geany", "mousepad", "code"):
        return "editor"
    return None


def dock(items):
    """Opaque icon dock with per-app running dots and bounded extra windows."""
    chips = []
    pins = available_pins()
    for key, icon, _command in pins:
        matches = [item for item in items if pin_for(item) == key]
        active = any(item[2] for item in matches)
        background = "#303640" if active else "#272d36" if matches else "#1b1f26"
        hidden = bool(matches) and all(item[3] for item in matches)
        foreground = "#ffb21a" if active else "#9ca7b6" if hidden else PIN_COLORS[key]
        dot = "○" + (str(min(len(matches), 99)) if len(matches) > 1 else "") if hidden else str(min(len(matches), 99)) if len(matches) > 1 else "•" if matches else " "
        chips.append(
            f"%{{A1:ooonana-window-list --dock-open {key}:}}"
            f"%{{A3:ooonana-window-list --dock-actions {key}:}}"
            f"%{{B{background}}}%{{F{foreground}}}%{{T2}} {icon} %{{T-}}{dot} "
            f"%{{B-}}%{{F-}}%{{A}}%{{A}}"
        )
    pinned_keys = {pin[0] for pin in pins}
    other = sorted((item for item in items if pin_for(item) not in pinned_keys), key=lambda item: (not item[2], item[3]))
    if other:
        chips.append("%{F#596574}│%{F-}")
    for item in other[:1]:
        con_id, name, focused, hidden = item[:4]
        if not isinstance(con_id, int) or con_id <= 0:
            continue
        short_name = name.removeprefix("Ooonana ")
        title = short_name[:10] + ("…" if len(short_name) > 10 else "")
        marker = "●" if focused else "○" if hidden else "·"
        chips.append(
            f"%{{A1:ooonana-window-list --focus {con_id}:}}"
            f"%{{A3:ooonana-window-list --actions {con_id}:}}"
            f"%{{B#272d36}}%{{F#ffb21a}} {marker} %{{F#f5f5f7}}{title} "
            f"%{{F-}}%{{B-}}%{{A}}%{{A}}"
        )
    if len(other) > 1:
        chips.append(f"%{{A1:ooonana-window-list --menu:}}%{{A3:ooonana-window-list --actions:}} +{len(other) - 1} %{{A}}%{{A}}")
    return " ".join(chips)


def dock_open(items, key):
    command = next((command for pin, _icon, command in PINS if pin == key), None)
    if command is None:
        return
    matches = [item for item in items if pin_for(item) == key]
    if matches:
        item = matches[0] if len(matches) == 1 else choose(matches, "Open app session")
        if item is not None:
            focus(item)
        return
    try:
        subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        return


def dock_actions(items, key):
    if not any(pin == key for pin, _icon, _command in PINS):
        return
    matches = [item for item in items if pin_for(item) == key]
    if not matches:
        if choose([(0, f"Open {key.title()}", False, False, "")], "Dock") is not None:
            dock_open(items, key)
        return
    item = matches[0] if len(matches) == 1 else choose(matches, "App sessions")
    if item is not None:
        actions_menu(items, item[0])


def focus(item):
    con_id, _name, _active, hidden = item[:4]
    commands = []
    if hidden:
        commands.append(f"[con_id={con_id}] scratchpad show")
    commands.append(f"[con_id={con_id}] focus")
    subprocess.run(["i3-msg", "; ".join(commands)], check=False)


def choose(items, prompt):
    if not items:
        return None
    choices = [
        f"{'* ' if item[2] else '  '}{item[1]}{' [hidden]' if item[3] else ''}"
        for item in items
    ]
    try:
        result = subprocess.run(
            ["rofi", "-dmenu", "-i", "-p", prompt, "-format", "i"],
            input="\n".join(choices) + "\n",
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=30,
            check=False,
        )
        selected = int(result.stdout.strip())
    except (OSError, ValueError, subprocess.SubprocessError):
        return None
    return items[selected] if 0 <= selected < len(items) else None


def menu(items, close=False):
    item = choose(items, "Close window" if close else "Open window")
    if item is None:
        return
    if close:
        subprocess.run(["i3-msg", f"[con_id={item[0]}] kill"], check=False)
    else:
        focus(item)


def actions_menu(items, con_id=None):
    item = next((entry for entry in items if entry[0] == con_id), None) if con_id else choose(items, "Window actions")
    if item is None:
        return
    popup = Path(__file__).resolve().parents[1] / "lib/ooonana/ui/window_menu.py"
    if os.environ.get("DISPLAY") and os.environ.get("OOONANA_WINDOW_MENU", "gtk") != "rofi" and popup.is_file():
        command = ["python3", str(popup), "--window", str(item[0]), "--title", item[1]]
        if item[3]:
            command.append("--hidden")
        try:
            subprocess.Popen(command, start_new_session=True)
            return
        except OSError:
            pass
    choices = ("Open / focus", "Minimize / hide", "Fullscreen toggle", "Close window")
    try:
        result = subprocess.run(
            ["rofi", "-dmenu", "-i", "-p", item[1][:20], "-format", "i"],
            input="\n".join(choices) + "\n", text=True,
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=30, check=False,
        )
        selected = int(result.stdout.strip())
    except (OSError, ValueError, subprocess.SubprocessError):
        return
    if 0 <= selected < 4:
        window_action(item, ("show", "minimize", "fullscreen", "close")[selected])


def window_action(item, action):
    if action == "show":
        focus(item)
    elif action == "minimize":
        subprocess.run(["i3-msg", f"[con_id={item[0]}] move scratchpad"], check=False)
    elif action == "fullscreen":
        if item[3]:
            focus(item)
        subprocess.run(["i3-msg", f"[con_id={item[0]}] fullscreen toggle"], check=False)
    elif action == "close":
        subprocess.run(["i3-msg", f"[con_id={item[0]}] kill"], check=False)


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "--watch-dock":
        sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib/ooonana"))
        from i3_events import trees
        previous = None
        while True:
            try:
                for snapshot in trees():
                    value = dock(windows(snapshot))
                    if value != previous:
                        print(value, flush=True)
                        previous = value
            except BrokenPipeError:
                return
            except (OSError, EOFError, ValueError, subprocess.SubprocessError):
                try:
                    print(dock([]), flush=True)
                except BrokenPipeError:
                    return
            time.sleep(2)
        return
    if len(sys.argv) > 1 and sys.argv[1] == "--dock-geometry":
        dock_geometry()
        return
    if len(sys.argv) > 1 and sys.argv[1] == "--panel-geometry":
        panel_geometry()
        return
    items = windows()
    if len(sys.argv) == 4 and sys.argv[1] == "--window-action":
        try:
            identifier = int(sys.argv[3])
        except ValueError:
            return
        item = next((entry for entry in items if entry[0] == identifier), None)
        if item and sys.argv[2] in ("show", "minimize", "fullscreen", "close"):
            window_action(item, sys.argv[2])
        return
    if len(sys.argv) > 1 and sys.argv[1] == "--focused-actions":
        focused = next((item for item in items if item[2]), None)
        actions_menu(items, focused[0] if focused else None)
        return
    if len(sys.argv) > 1 and sys.argv[1] == "--dock":
        print(dock(items))
        return
    if len(sys.argv) > 2 and sys.argv[1] == "--dock-open":
        dock_open(items, sys.argv[2])
        return
    if len(sys.argv) > 2 and sys.argv[1] == "--dock-actions":
        dock_actions(items, sys.argv[2])
        return
    if len(sys.argv) > 1 and sys.argv[1] == "--menu":
        menu(items)
        return
    if len(sys.argv) > 1 and sys.argv[1] in ("--close-menu", "--kill-menu"):
        menu(items, close=True)
        return
    if len(sys.argv) > 1 and sys.argv[1] == "--actions" and len(sys.argv) == 2:
        actions_menu(items)
        return
    if len(sys.argv) > 1 and sys.argv[1] in ("--focus", "--actions"):
        try:
            con_id = int(sys.argv[2])
        except (IndexError, ValueError):
            return
        if con_id <= 0:
            return
        item = next((entry for entry in items if entry[0] == con_id), None)
        if item is None:
            return
        if sys.argv[1] == "--focus":
            focus(item)
        else:
            actions_menu(items, con_id)
        return
    if len(sys.argv) > 1 and sys.argv[1] == "--plain":
        print(compact(items))
        return
    print(bar(items))


if __name__ == "__main__":
    main()
