#!/usr/bin/env python3
import json
import subprocess
import sys


def tree():
    try:
        output = subprocess.check_output(
            ["i3-msg", "-t", "get_tree"], text=True, stderr=subprocess.DEVNULL, timeout=3
        )
        return json.loads(output)
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
        return {}


def leaves(node, in_scratchpad=False):
    found = []
    scratchpad_state = node.get("scratchpad_state")
    hidden = (
        in_scratchpad
        or node.get("name") == "__i3_scratch"
        or scratchpad_state not in (None, "none")
    )
    if node.get("window") is not None and node.get("name"):
        found.append((node, hidden))
    for key in ("nodes", "floating_nodes"):
        for child in node.get(key, []):
            found.extend(leaves(child, hidden))
    return found


def windows():
    items = []
    for node, hidden in leaves(tree()):
        con_id = node.get("id")
        if not isinstance(con_id, int):
            continue
        name = " ".join(str(node.get("name", "")).split()) or "window"
        items.append((con_id, name, bool(node.get("focused")), hidden))
    return items


def compact(items):
    if not items:
        return "desktop"
    focused = next((item for item in items if item[2]), items[0])
    name = focused[1]
    title = name[:22] + ("..." if len(name) > 22 else "")
    hidden_count = sum(1 for item in items if item[3])
    suffix = f" +{len(items) - 1}" if len(items) > 1 else ""
    hidden = f" ({hidden_count} hidden)" if hidden_count else ""
    return f"* {title}{suffix}{hidden}"


def menu(items, close=False):
    if not items:
        return
    choices = [
        f"{'* ' if active else '  '}{name}{' [hidden]' if hidden else ''}"
        for _con_id, name, active, hidden in items
    ]
    try:
        result = subprocess.run(
            ["rofi", "-dmenu", "-i", "-p", "Close window" if close else "Windows", "-format", "i"],
            input="\n".join(choices) + "\n",
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=30,
            check=False,
        )
        selected = int(result.stdout.strip())
    except (OSError, ValueError, subprocess.SubprocessError):
        return
    if 0 <= selected < len(items):
        con_id, _name, _active, hidden = items[selected]
        if close:
            subprocess.run(["i3-msg", f"[con_id={con_id}] kill"], check=False)
            return
        commands = []
        if hidden:
            commands.append(f"[con_id={con_id}] scratchpad show")
        commands.append(f"[con_id={con_id}] focus")
        subprocess.run(["i3-msg", "; ".join(commands)], check=False)


def main():
    items = windows()
    if len(sys.argv) > 1 and sys.argv[1] == "--menu":
        menu(items)
        return
    if len(sys.argv) > 1 and sys.argv[1] in ("--close-menu", "--kill-menu"):
        menu(items, close=True)
        return
    print(compact(items))


if __name__ == "__main__":
    main()
