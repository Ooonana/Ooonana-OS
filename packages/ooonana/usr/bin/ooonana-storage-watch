#!/usr/bin/env python3
"""One low-frequency, silent storage warning worker per logged-in user."""
import fcntl
import os
from pathlib import Path
import subprocess
import sys
import time

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib/ooonana"))
from storage_health import storage_health


def main():
    if storage_health()["mode"] == "installed":
        return
    state = Path(os.environ.get("XDG_RUNTIME_DIR", str(Path.home() / ".local/state"))) / "ooonana"
    state.mkdir(parents=True, exist_ok=True)
    with (state / "storage-watch.lock").open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        previous, notified = None, 0
        while True:
            health = storage_health()
            if health["level"] in ("low", "critical") and (health["level"] != previous or time.monotonic() - notified >= 900):
                try:
                    subprocess.run(["notify-send", "--hint=string:suppress-sound:true",
                                    "--urgency=" + ("critical" if health["level"] == "critical" else "normal"),
                                    "Live storage needs attention", health["caption"] + ". Back up files; stop large downloads. No automatic deletion."],
                                   timeout=5, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                except (OSError, subprocess.SubprocessError):
                    pass
                notified = time.monotonic()
            previous = health["level"]
            time.sleep(60)


if __name__ == "__main__":
    main()
