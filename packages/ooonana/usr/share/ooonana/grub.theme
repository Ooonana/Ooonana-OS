title-text: ""
title-color: "#f5f5f7"
desktop-image: "/boot/grub/background.png"
desktop-image-scale-method: "stretch"
desktop-color: "#101317"
terminal-font: "Unifont Regular 16"
message-color: "#f5f5f7"
message-bg-color: "#101317"

+ image {
  id = "ooonana-brand-mark"
  file = "boot-mark.png"
  left = 50%-64
  top = 11%
  width = 128
  height = 88
}

+ label {
  id = "ooonana-brand-name"
  text = "Ooonana OS"
  left = 16%
  top = 11%+104
  width = 68%
  height = 20
  color = "#f5f5f7"
  font = "Unifont Regular 16"
  align = "center"
}

+ label {
  text = "Choose how to start"
  left = 16%+6
  top = 11%+136
  width = 68%
  height = 20
  color = "#b4bdc8"
  font = "Unifont Regular 16"
}

+ boot_menu {
  left = 16%
  top = 11%+168
  width = 68%
  height = 33%
  visible = true
  item_font = "Unifont Regular 16"
  selected_item_font = "Unifont Regular 16"
  item_color = "#b4bdc8"
  selected_item_color = "#ffb21a"
  item_height = 24
  item_padding = 6
  icon_width = 0
  icon_height = 0
  item_icon_space = 0
  item_spacing = 5
  scrollbar = false
}

+ label {
  text = "ARROWS select  |  ENTER boot  |  ESC back"
  left = 16%
  top = 82%
  width = 68%
  height = 18
  color = "#b4bdc8"
  align = "center"
}

+ label {
  id = "__timeout__"
  text = "Starting in %d s"
  left = 16%
  top = 88%
  width = 68%
  height = 18
  color = "#b4bdc8"
  font = "Unifont Regular 16"
  align = "center"
}
