#!/bin/sh
set -eu

STATE_DIR="${OOONANA_OPENVINO_STATE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/ooonana-openvino}"
ROOTFS="$STATE_DIR/rootfs"
PROJECT="${OOONANA_OPENVINO_PROJECT:-/usr/lib/ooonana/openvino-chat}"
OPENVINO_HOME="${OOONANA_OPENVINO_HOME:-$HOME/.openvino}"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/ooonana-openvino"
WORKSPACE="${OOONANA_OPENVINO_WORKSPACE:-$PWD}"
runtime_state=missing
fingerprint_file="$PROJECT/pyproject.toml"
[ ! -f "$PROJECT/APP-MANIFEST.sha256" ] || fingerprint_file="$PROJECT/APP-MANIFEST.sha256"
if [ -f "$ROOTFS/.ooonana-openvino-ready" ]; then
  runtime_state=outdated
  if [ -f "$PROJECT/pyproject.toml" ] && \
    [ "$(cat "$ROOTFS/.ooonana-openvino-ready")" = "$(sha256sum "$fingerprint_file" | awk '{print $1}')" ]; then
    runtime_state=ready
  fi
fi
if [ -e "$STATE_DIR/.runtime-promotion" ] || [ -L "$STATE_DIR/.runtime-promotion" ]; then
  runtime_state=recovery
fi

usage() {
  cat <<'EOF'
Ooonana OpenVINO Chat

Usage:
  openvino setup [--force]
  openvino doctor
  openvino status
  openvino download qwen3.5|gemma
  openvino chat [--device GPU|CPU]
  openvino api start|status|stop [--device GPU|CPU]

Runtime and model files live outside package database in user home.
Inference works offline after runtime and model download finish.
EOF
}

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
  setup)
    shift
    exec /usr/bin/ooonana-openvino-setup "$@"
    ;;
  doctor)
    printf 'Ooonana OpenVINO doctor\n'
    printf 'runtime: %s\n' "$runtime_state"
    printf 'bubblewrap: %s\n' "$([ -x /usr/bin/bwrap ] && printf ready || printf missing)"
    printf 'gpu: %s\n' "$([ -d /dev/dri ] && printf detected || printf missing)"
    if command -v ooonana-memory >/dev/null 2>&1; then
      ooonana-memory status || true
    fi
    if [ "$runtime_state" != ready ]; then
      printf 'next: openvino setup\n'
      exit 1
    fi
    set -- status
    ;;
esac

[ "$runtime_state" != recovery ] || {
  printf 'openvino: interrupted runtime promotion; run: openvino setup\n' >&2
  exit 1
}
[ -x /usr/bin/bwrap ] || {
  printf 'openvino: bubblewrap missing; run: ooonana fix openvino-chat --reinstall\n' >&2
  exit 1
}
[ -f "$ROOTFS/.ooonana-openvino-ready" ] || {
  printf 'openvino: runtime missing; run: openvino setup\n' >&2
  exit 1
}
[ -d "$PROJECT/src/openvino_chat" ] || {
  printf 'openvino: package payload missing; reinstall openvino-chat\n' >&2
  exit 1
}
[ "$runtime_state" = ready ] || {
  printf 'openvino: runtime outdated; run: openvino setup\n' >&2
  exit 1
}
[ -d "$WORKSPACE" ] || WORKSPACE="$HOME"

mkdir -p "$OPENVINO_HOME" "$CACHE_DIR"

# Browser GUI uses loopback HTTP in shared network namespace. Pass only validated
# localhost GUI URLs through user-private FIFO to host Chromium.
umask 077
BRIDGE_DIR="$(mktemp -d "$CACHE_DIR/.gui-bridge.XXXXXXXX")"
BRIDGE_FIFO="$BRIDGE_DIR/request"
mkfifo -m 600 "$BRIDGE_FIFO"
inside_fifo="/root/.cache/${BRIDGE_DIR##*/}/request"
bridge_pid=""
cleanup_bridge() {
  if [ -n "$bridge_pid" ]; then
    kill "$bridge_pid" 2>/dev/null || true
    wait "$bridge_pid" 2>/dev/null || true
  fi
  rm -f -- "$BRIDGE_FIFO"
  rmdir -- "$BRIDGE_DIR" 2>/dev/null || true
}
trap cleanup_bridge EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
valid_gui_url() {
  case "$1" in
    http://127.0.0.1:*) ;;
    *) return 1 ;;
  esac
  rest="${1#http://127.0.0.1:}"
  port="${rest%%/*}"
  case "$port" in ''|*[!0-9]*) return 1 ;; esac
  [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || return 1
  case "$rest" in
    "$port/openvino.html#token="*|"$port/duck.html#token="*) ;;
    *) return 1 ;;
  esac
  token="${rest#*#token=}"
  case "$token" in ''|*[!A-Za-z0-9_-]*) return 1 ;; esac
  [ "${#token}" -le 100 ]
}
watch_browser() {
  while :; do
    if IFS= read -r browser_url < "$BRIDGE_FIFO"; then
      if valid_gui_url "$browser_url"; then
        ooonana-browser "$browser_url" >/dev/null 2>&1 &
      fi
    fi
  done
}
watch_browser &
bridge_pid=$!

/usr/bin/bwrap \
  --unshare-user \
  --unshare-uts \
  --unshare-ipc \
  --uid 0 \
  --gid 0 \
  --bind "$ROOTFS" / \
  --dev-bind /dev /dev \
  --proc /proc \
  --ro-bind /sys /sys \
  --ro-bind "$PROJECT" /opt/openvino-chat \
  --bind "$OPENVINO_HOME" /root/.openvino \
  --bind "$CACHE_DIR" /root/.cache \
  --bind "$WORKSPACE" /workspace \
  --tmpfs /run \
  --tmpfs /tmp \
  --setenv HOME /root \
  --setenv OPENVINO_HOME /root/.openvino \
  --setenv OPENVINO_MEMORY_POLICY "${OPENVINO_MEMORY_POLICY:-warn}" \
  --setenv HF_HOME /root/.cache/huggingface \
  --setenv BROWSER /opt/openvino-chat/scripts/browser-bridge.sh \
  --setenv OOONANA_OPENVINO_BROWSER_FIFO "$inside_fifo" \
  --setenv PATH /opt/openvino-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
  --setenv TERM "${TERM:-xterm-256color}" \
  --chdir /workspace \
  /opt/openvino-venv/bin/openvino "$@"
