#!/bin/sh
set -eu

STATE_DIR="${OOONANA_OPENVINO_STATE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/ooonana-openvino}"
ROOTFS="$STATE_DIR/rootfs"
PROJECT="${OOONANA_OPENVINO_PROJECT:-/usr/lib/ooonana/openvino-chat}"
if [ -f "$PROJECT/runtime-linux.env" ]; then . "$PROJECT/runtime-linux.env"; fi
BASE_URL="${OOONANA_OPENVINO_ROOTFS_URL:-${OOONANA_RUNTIME_BASE_URL:-https://cloud-images.ubuntu.com/minimal/releases/noble/release-20261001}}"
PINNED_ROOTFS_SHA256="${OOONANA_OPENVINO_ROOTFS_SHA256:-${OOONANA_RUNTIME_ROOTFS_SHA256:-}}"
APT_SNAPSHOT="${OOONANA_OPENVINO_APT_SNAPSHOT:-${OOONANA_RUNTIME_APT_SNAPSHOT:-20261002T000000Z}}"
ROOTFS_NAME="ubuntu-24.04-minimal-cloudimg-amd64-root.tar.xz"
FORCE=0
DRY_RUN=0

usage() {
  cat <<'EOF'
Install Ooonana OpenVINO local AI runtime.

Usage:
  openvino setup [--force] [--dry-run]

Downloads Ubuntu 24.04 minimal userspace, verifies Ubuntu SHA256SUMS, installs
OpenVINO Chat plus Intel GPU runtime, then keeps runtime in user home.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --force) FORCE=1 ;;
    --dry-run) DRY_RUN=1 ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'openvino setup: unknown option: %s\n' "$1" >&2; exit 2 ;;
  esac
  shift
done

if [ "$DRY_RUN" -eq 1 ]; then
  printf 'state: %s\n' "$STATE_DIR"
  printf 'rootfs: %s\n' "$ROOTFS"
  printf 'download: %s/%s\n' "$BASE_URL" "$ROOTFS_NAME"
  printf 'verify: %s/SHA256SUMS\n' "$BASE_URL"
  printf 'install: Ubuntu Python venv + openvino-genai + Intel OpenCL runtime\n'
  printf 'OOONANA_OPENVINO_SETUP_DRY_OK\n'
  exit 0
fi

live_mode_file="${OOONANA_LIVE_MODE_FILE:-/mnt/ooonana-live/persistence-mode}"
live_mode=""
if [ -e "$live_mode_file" ] || [ -L "$live_mode_file" ]; then
  live_mode="$(cat "$live_mode_file")" || {
    printf 'openvino setup: cannot read live storage mode; refusing download.\n' >&2
    exit 1
  }
  case "$live_mode" in
    usb|ram|usb-temporary) ;;
    *) printf 'openvino setup: unknown live storage mode; refusing download.\n' >&2; exit 1 ;;
  esac
fi
case "$live_mode" in
  ram|usb-temporary)
    if [ "${OOONANA_OPENVINO_ALLOW_VOLATILE:-0}" != 1 ]; then
      printf 'openvino setup: live storage is %s; runtime and models would fill RAM or vanish on reboot.\n' "$live_mode" >&2
      printf 'Create an OOONANA_PERSIST ext4 partition and boot Persistent USB mode, or install Ooonana to disk.\n' >&2
      exit 1
    fi
    printf 'openvino setup: WARNING: volatile live storage (%s)\n' "$live_mode" >&2
    ;;
esac

available_kb="$(awk '$1 == "MemAvailable:" { print $2; exit }' /proc/meminfo 2>/dev/null || true)"
swap_free_kb="$(awk '$1 == "SwapFree:" { print $2; exit }' /proc/meminfo 2>/dev/null || true)"
if [ -n "$available_kb" ] && [ "$available_kb" -lt 4194304 ]; then
  printf 'openvino setup: WARNING: less than 4 GiB available physical RAM; large models may not load.\n' >&2
  printf 'Free swap: %s KiB (not extra physical RAM).\n' "${swap_free_kb:-0}" >&2
fi

[ "$(uname -m)" = x86_64 ] || {
  printf 'openvino setup: x86_64 Intel systems only\n' >&2
  exit 1
}
[ -x /usr/bin/bwrap ] || {
  printf 'openvino setup: bubblewrap missing; reinstall openvino-chat\n' >&2
  exit 1
}
[ -d "$PROJECT/src/openvino_chat" ] || {
  printf 'openvino setup: package payload missing\n' >&2
  exit 1
}

mkdir -p "$STATE_DIR"
STATE_DIR="$(cd "$STATE_DIR" && pwd -P)"
ROOTFS="$STATE_DIR/rootfs"
GENERATIONS="$STATE_DIR/.runtime-generations"
JOURNAL="$STATE_DIR/.runtime-promotion"
umask 077
[ ! -L "$STATE_DIR/.setup.lock" ] && \
  { [ ! -e "$STATE_DIR/.setup.lock" ] || [ -f "$STATE_DIR/.setup.lock" ]; } || {
    printf 'openvino setup: invalid setup lock; preserve state for inspection\n' >&2; exit 1;
  }
exec 9>>"$STATE_DIR/.setup.lock"
if command -v flock >/dev/null 2>&1; then
  flock -n 9 || { printf 'openvino setup: another setup is running\n' >&2; exit 1; }
elif command -v busybox >/dev/null 2>&1; then
  busybox flock -n 9 || { printf 'openvino setup: busy or flock unavailable\n' >&2; exit 1; }
else
  printf 'openvino setup: flock required for safe runtime replacement\n' >&2
  exit 1
fi
[ ! -L "$GENERATIONS" ] || { printf 'openvino setup: generations directory must not be a symlink\n' >&2; exit 1; }
mkdir -p "$GENERATIONS"

recover_promotion() {
  [ -e "$JOURNAL" ] || [ -L "$JOURNAL" ] || return 0
  [ -f "$JOURNAL" ] && [ ! -L "$JOURNAL" ] || return 1
  record="$(cat "$JOURNAL")" || return 1
  case "$record" in runtime.*) suffix="${record#runtime.}" ;; *) return 1 ;; esac
  case "$suffix" in ''|*[!A-Za-z0-9]*) return 1 ;; esac
  [ "${#suffix}" -eq 8 ] || return 1
  recovery="$GENERATIONS/$record"
  [ -d "$recovery" ] && [ ! -L "$recovery" ] || return 1
  if [ -e "$recovery/previous" ] || [ -L "$recovery/previous" ]; then
    [ -d "$recovery/previous" ] && [ ! -L "$recovery/previous" ] || return 1
    if [ -L "$ROOTFS" ]; then
      [ "$(readlink "$ROOTFS")" = ".runtime-generations/$record/rootfs" ] || return 1
      rm -f -- "$ROOTFS"  # Only the verified new pointer, never runtime contents.
    elif [ -e "$ROOTFS" ]; then
      return 1  # Ambiguous replacement: preserve both trees for inspection.
    fi
    mv "$recovery/previous" "$ROOTFS" || return 1
    sync -f "$STATE_DIR" || return 1
  else
    # Journal persisted before the old directory moved, or rollback completed.
    [ -d "$ROOTFS" ] && [ ! -L "$ROOTFS" ] || return 1
  fi
  rm -f -- "$JOURNAL" || return 1
  sync -f "$STATE_DIR" || return 1
  printf 'openvino setup: recovered previous runtime\n' >&2
}
recover_promotion || {
  printf 'openvino setup: unresolved runtime promotion; preserve state for recovery\n' >&2
  exit 1
}
if [ -e "$ROOTFS" ] || [ -L "$ROOTFS" ]; then
  [ -d "$ROOTFS" ] || { printf 'openvino setup: invalid runtime path; preserve state for inspection\n' >&2; exit 1; }
fi

available_kb="$(df -Pk "$STATE_DIR" | awk 'NR == 2 {print $4}')"
required_kb=4194304  # Fresh userspace + packages + download/staging allowance.
if [ -f "$ROOTFS/.ooonana-openvino-ready" ] && [ "$FORCE" -eq 0 ]; then
  runtime_kb="$(du -sk "$ROOTFS/." | awk '{print $1}')"
  case "$runtime_kb" in ''|*[!0-9]*) printf 'openvino setup: cannot measure runtime storage\n' >&2; exit 1 ;; esac
  required_kb=$((runtime_kb + 524288))  # Full working copy plus 512 MiB reserve.
fi
case "$available_kb" in ''|*[!0-9]*) printf 'openvino setup: cannot measure free storage\n' >&2; exit 1 ;; esac
[ "$available_kb" -ge "$required_kb" ] || {
  printf 'openvino setup: insufficient storage; staging needs at least %s KiB free; available %s KiB. Previous runtime untouched.\n' "$required_kb" "$available_kb" >&2
  exit 1
}

run_inside() {
  target="$1"
  /usr/bin/bwrap \
    --unshare-all \
    --share-net \
    --uid 0 \
    --gid 0 \
    --bind "$target" / \
    --dev-bind /dev /dev \
    --proc /proc \
    --ro-bind /sys /sys \
    --ro-bind "$PROJECT" /opt/openvino-chat \
    --tmpfs /run \
    --tmpfs /tmp \
    --setenv HOME /root \
    --setenv DEBIAN_FRONTEND noninteractive \
    --setenv OOONANA_OPENVINO_REFRESH_DEPENDENCIES "${OOONANA_OPENVINO_REFRESH_DEPENDENCIES:-0}" \
    --setenv OOONANA_RUNTIME_APT_SNAPSHOT "$APT_SNAPSHOT" \
    --setenv PATH /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    --chdir / \
    /bin/bash -lc '
      set -e
      printf "APT::Sandbox::User \"root\";\n" >/etc/apt/apt.conf.d/99ooonana-root
      apt-get update --snapshot "$OOONANA_RUNTIME_APT_SNAPSHOT"
      apt-get install --snapshot "$OOONANA_RUNTIME_APT_SNAPSHOT" -y --no-install-recommends \
        ca-certificates python3 python3-venv python3-pip \
        libgl1 libnuma1 libtbb12 ocl-icd-libopencl1 intel-opencl-icd clinfo pciutils procps
      dpkg-query -W > /opt/ooonana-system-dependencies.lock
      rm -rf /var/lib/apt/lists/*
      if [ ! -x /opt/openvino-venv/bin/python ]; then
        python3 -m venv /opt/openvino-venv
      fi
      rm -rf /tmp/ooonana-openvino-src
      mkdir -p /tmp/ooonana-openvino-src
      cp -R --no-preserve=mode,ownership,timestamps,xattr \
        /opt/openvino-chat/. /tmp/ooonana-openvino-src/
      chmod -R u+rwX /tmp/ooonana-openvino-src
      find /tmp/ooonana-openvino-src -type d -name "*.egg-info" -prune -exec rm -rf {} +
      if [ -f /opt/openvino-dependencies.lock ] && [ "$OOONANA_OPENVINO_REFRESH_DEPENDENCIES" != 1 ]; then
        /opt/openvino-venv/bin/python -m pip install --no-cache-dir --require-hashes -c /opt/openvino-dependencies.lock -r /tmp/ooonana-openvino-src/requirements-linux-full.lock
      else
        /opt/openvino-venv/bin/python -m pip install --no-cache-dir --require-hashes -r /tmp/ooonana-openvino-src/requirements-linux-full.lock
      fi
      /opt/openvino-venv/bin/python -m pip install --no-cache-dir --no-build-isolation --no-deps /tmp/ooonana-openvino-src
      /opt/openvino-venv/bin/python -c "import openvino, openvino_genai, openvino_chat; print(\"OpenVINO runtime ready\")"
      /opt/openvino-venv/bin/python -m pip freeze --all | grep -vi "^openvino-chat" > /opt/openvino-dependencies.lock
      fingerprint=/opt/openvino-chat/pyproject.toml
      [ ! -f /opt/openvino-chat/APP-MANIFEST.sha256 ] || fingerprint=/opt/openvino-chat/APP-MANIFEST.sha256
      sha256sum "$fingerprint" | awk "{print \$1}" > /.ooonana-openvino-ready
      /opt/openvino-venv/bin/python -c "import json,importlib.metadata as m; print(json.dumps({\"openvino\":m.version(\"openvino\"),\"genai\":m.version(\"openvino-genai\"),\"validation\":\"import-only\",\"inference_validated\":False},sort_keys=True))" > /opt/openvino-runtime-manifest.json
    ' 9>&-
}

work="$(mktemp -d "$STATE_DIR/.setup.XXXXXX")"
candidate="$work/rootfs"
archive="$work/$ROOTFS_NAME"
checksums="$work/SHA256SUMS"
cleanup() {
  result=$?
  if [ "$result" -ne 0 ]; then
    recover_promotion || printf 'openvino setup: promotion recovery remains pending\n' >&2
  fi
  rm -rf "$work"
  trap - EXIT
  exit "$result"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if [ -f "$ROOTFS/.ooonana-openvino-ready" ] && [ "$FORCE" -eq 0 ]; then
  printf 'Staging OpenVINO runtime update...\n'
  mkdir -p "$candidate"
  cp -a "$ROOTFS/." "$candidate/"
  rm -f "$candidate/.ooonana-openvino-ready"
else
printf 'Downloading verified Ubuntu userspace...\n'
curl -fL --retry 5 --retry-delay 3 "$BASE_URL/SHA256SUMS" -o "$checksums"
curl -fL --retry 5 --retry-delay 3 "$BASE_URL/$ROOTFS_NAME" -o "$archive"
expected="$(awk -v file="$ROOTFS_NAME" '{name=$2; sub(/^\*/, "", name); if (name==file) {print $1; exit}}' "$checksums")"
[ -n "$expected" ] || {
  printf 'openvino setup: checksum entry missing\n' >&2
  exit 1
}
actual="$(sha256sum "$archive" | awk '{print $1}')"
[ "$actual" = "$expected" ] || {
  printf 'openvino setup: Ubuntu rootfs checksum mismatch\n' >&2
  exit 1
}
[ -n "$PINNED_ROOTFS_SHA256" ] && [ "$actual" = "$PINNED_ROOTFS_SHA256" ] || {
  printf 'openvino setup: rootfs differs from pinned release; verify explicit SHA override for custom base URL\n' >&2
  exit 1
}

mkdir -p "$candidate"
tar --no-same-owner \
  --exclude='./dev' --exclude='./dev/*' \
  --exclude='dev' --exclude='dev/*' \
  -xJf "$archive" -C "$candidate"
mkdir -p "$candidate/dev"
rm -f "$candidate/etc/resolv.conf"
cp /etc/resolv.conf "$candidate/etc/resolv.conf"
fi
run_inside "$candidate"

fingerprint="$PROJECT/pyproject.toml"
[ ! -f "$PROJECT/APP-MANIFEST.sha256" ] || fingerprint="$PROJECT/APP-MANIFEST.sha256"
[ -f "$candidate/.ooonana-openvino-ready" ] && \
  [ "$(cat "$candidate/.ooonana-openvino-ready")" = "$(sha256sum "$fingerprint" | awk '{print $1}')" ] || {
    printf 'openvino setup: candidate readiness fingerprint missing or mismatched\n' >&2
    exit 1
  }
generation="$(mktemp -d "$GENERATIONS/runtime.XXXXXXXX")"
mv "$candidate" "$generation/rootfs"
sync -f "$generation"
ln -s ".runtime-generations/${generation##*/}/rootfs" "$work/rootfs.next"
[ ! -e "$JOURNAL" ] && [ ! -L "$JOURNAL" ] || {
  printf 'openvino setup: promotion state changed during staging; refusing replacement\n' >&2; exit 1;
}
if [ -d "$ROOTFS" ] && [ ! -L "$ROOTFS" ]; then
  # Legacy directory conversion has a journal; ordinary generation switches
  # thereafter replace one symlink atomically. Completed generations stay.
  printf '%s\n' "${generation##*/}" >"$work/promotion"
  mv -T "$work/promotion" "$JOURNAL"
  sync -f "$STATE_DIR"
  mv "$ROOTFS" "$generation/previous"
  sync -f "$generation"
fi
mv -Tf "$work/rootfs.next" "$ROOTFS"
sync -f "$STATE_DIR"
rm -f -- "$JOURNAL"
sync -f "$STATE_DIR"
printf 'OpenVINO local AI ready.\n'
printf 'Previous runtime generations retained; restart running AI sessions to use this snapshot.\n'
printf 'Next: openvino download qwen3.5\n'
printf 'Then: openvino chat --device GPU\n'
