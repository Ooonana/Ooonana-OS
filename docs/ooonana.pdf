          image_data[dst_pos + 3] = 0xff; /* XXX: do it once */
          src = \(src + 4\) | 0;
          dst_pos = \(dst_pos + 4\) | 0;
        }
        data = \(data + stride\) | 0;
        dst_pos1 = \(dst_pos1 + image_stride\) | 0;
      }
      update_framebuffer\(display.width, display.height, image_data, y, h\);
      //display.ctx.putImageData\(display.image, 0, 0, x, y, w, h\);
    }

